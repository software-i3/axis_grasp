<launch>
  <arg name="config" default="$(find axis_grasp)/config/default.yaml"/>
  <arg name="calibration" default="$(find axis_grasp)/config/calibration_underwater.json"/>

  <!-- Optional overrides for the label source. Left empty, the values in
       `config` apply. Use these to switch to the DetectedInstances mask source
       without editing the YAML:
         roslaunch axis_grasp axis_grasp.launch label_source:=detections \
           detector_name:=sim_front_cam_seg
       `detection_classes` is a list, so set it in the YAML rather than here. -->
  <arg name="label_source" default=""/>
  <arg name="detections_topic" default=""/>
  <arg name="detector_name" default=""/>
  <arg name="min_confidence" default=""/>

  <!-- Range input. Left empty, the values in `config` apply. Switch to the
       depth source, which converts bx_msgs/DepthImage to disparity, without
       editing the YAML:
         roslaunch axis_grasp axis_grasp.launch input_kind:=depth \
           depth_topic:=/depth_image label_source:=detections
       `disparity_topic` is the mirror of `depth_topic` and is what makes the
       A/B in docs/BUILD_AND_RUN.md runnable: exactly one of the two is
       subscribed, per `input_kind`.
       `input_kind` is not a bool, so it is passed through as a string rather
       than with a type attribute. -->
  <arg name="input_kind" default=""/>
  <arg name="disparity_topic" default=""/>
  <arg name="depth_topic" default=""/>

  <!-- Straight-line rope removal, on by default (`remove_straight_rope` in
       `config`). Turn it off to keep the rope in the coherent vote
       accumulator, which is what the voting and grasp stages then see:
         roslaunch axis_grasp axis_grasp.launch remove_straight_rope:=false -->
  <arg name="remove_straight_rope" default=""/>

  <node pkg="axis_grasp" type="axis_grasp_node" name="axis_grasp_node"
        output="screen" required="true">
    <rosparam command="load" file="$(arg config)"/>
    <param name="calibration" value="$(arg calibration)"/>
    <param name="label_source" value="$(arg label_source)"
           if="$(eval arg('label_source') != '')"/>
    <param name="detections_topic" value="$(arg detections_topic)"
           if="$(eval arg('detections_topic') != '')"/>
    <param name="detector_name" value="$(arg detector_name)"
           if="$(eval arg('detector_name') != '')"/>
    <param name="min_confidence" value="$(arg min_confidence)"
           if="$(eval arg('min_confidence') != '')"/>
    <param name="input_kind" value="$(arg input_kind)"
           if="$(eval arg('input_kind') != '')"/>
    <param name="disparity_topic" value="$(arg disparity_topic)"
           if="$(eval arg('disparity_topic') != '')"/>
    <param name="depth_topic" value="$(arg depth_topic)"
           if="$(eval arg('depth_topic') != '')"/>
    <param name="remove_straight_rope" value="$(arg remove_straight_rope)"
           type="bool" if="$(eval arg('remove_straight_rope') != '')"/>
  </node>
</launch>
